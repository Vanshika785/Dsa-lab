#include <stdio.h>

int main() {
    
    int numbers[5];
    int i;

    printf("Enter 5 integer elements:\n");
    for(i = 0; i < 5; i++) {
        printf("Enter element for index %d: ", i);
        scanf("%d", &numbers[i]); 

    printf("\nThe created array elements are:\n");
    for(i = 0; i < 5; i++) {
        printf("numbers[%d] = %d\n", i, numbers[i]);
    }

    return 0;
}
